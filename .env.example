# Database
DATABASE_URL=sqlite+aiosqlite:///graphone.db

# LLM Providers (fill in real keys — never commit this file with values)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub
GITHUB_TOKEN=

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=...
GOOGLE_SHEET_ID=...

# Optional Redis (leave empty to use in-process asyncio.Queue)
REDIS_URL=

# Pipeline tuning
MAX_CONCURRENCY=10
LLM_MAX_RETRIES=4
FRESHNESS_HOURS=24
LOG_LEVEL=INFO

# LLM provider order (comma-separated)
LLM_PROVIDER_ORDER=gemini,groq,deepseek
